<?xml version="1.0" ?>
<robot name="omnidrive" xmlns:xacro="http://www.ros.org/wiki/xacro" >

<xacro:property name="body_color" value="Gazebo/Silver" />
<xacro:property name="lidar_color" value="Gazebo/DarkGrey" />
<xacro:property name="wheel_color" value="Gazebo/Black" />



<gazebo reference="base_link">
  <material>${body_color}</material>
  <mu1>0.2</mu1>
  <mu2>0.2</mu2>
  <self_collide>false</self_collide>
  <gravity>true</gravity>
</gazebo>

<xacro:macro name="wheel_gazebo" params="name">
  <gazebo reference="${name}">
    <material>${wheel_color}</material>
    <mu1>1.0</mu1>
    <mu2>0.0</mu2>
    <kp>1000000.0</kp>
    <kd>1.0</kd>
    <minDepth>0.001</minDepth>
    <maxVel>0.1</maxVel>
    <self_collide>false</self_collide>
  </gazebo>
</xacro:macro>

<xacro:wheel_gazebo name="WHEEL_FR"/>
<xacro:wheel_gazebo name="WHEEL_FL"/>
<xacro:wheel_gazebo name="WHEEL_BR"/>
<xacro:wheel_gazebo name="WHEEL_BL"/>
<!-- <plugin></plugin> -->
<gazebo>
  <plugin filename="gz_ros2_control-system" name="gz_ros2_control::GazeboSimROS2ControlPlugin">
      <!-- <parameters>/home/sarthak/mdam/install/robot_sim/share/robot_sim/config/ros2_controllers.yaml</parameters> -->
    <parameters>$(find bot_description)/config/controller.yaml</parameters>
    </plugin>
</gazebo>

</robot>
